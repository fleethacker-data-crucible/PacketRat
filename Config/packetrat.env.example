# Copy to packetrat.env (do not commit).

# --- AI: everything goes through Fairlead, the Fleet model router on this PC ---
# PacketRat holds no provider tokens, endpoints or vault items. Its only credential is its Fairlead key, kept in
# Windows Credential Manager as the generic credential "Fairlead/PacketRat". Install it from Fairlead (Clients, PacketRat).
# PACKETRAT_FAIRLEAD_URL=http://127.0.0.1:8776/v1/chat/completions    # another address on THIS PC only (a different port)
# PACKETRAT_FAIRLEAD_MODEL=auto                                        # the Fairlead route to ask for
# PACKETRAT_FAIRLEAD_PRIVACY=local                                     # keep prompts on local models
# PACKETRAT_FAIRLEAD_AUTOSTART=off                                     # on by default: start Fairlead when nothing answers
# FAIRLEAD_DIR=D:/Tools/Fairlead                                       # only if Fairlead is not next to PacketRat

# --- Triage ---
# Your organization's mail domain(s), comma-separated, for the organization-domain triage rules.
# A domain suffix also works. When unset, those rules never match.
# PACKETRAT_ORG_DOMAIN=example.org
# Bridge voice: your TalkForge assets folder (see docs/VOICE.md)
# PACKETRAT_TTS_DIR=C:\Users\me\Projects\TalkForge\assets
# Files provider (no Outlook): folder of exported .eml and .msg files
# PACKETRAT_MAIL_FOLDER=C:\Mail\Export

# --- Data folder ---
# Keep the action queue, rules, dismissals, counts and packetrat.log in a different (full-path) folder, for example a fresh
# one for a demo recording. Default: Logs under the PacketRat folder. Process files stay in Logs.
# PACKETRAT_DATA_DIR=C:\Demo\PacketRatData

# --- Lifecycle ---
# Closing the PacketRat browser tab stops the local PowerShell service (20 s after the last
# heartbeat, never during a scan). Set to 0 to keep it running (same as Launch-PacketRat.bat --stay).
# PACKETRAT_AUTO_STOP=1

# --- AI output ---
# Stream answers so a long generation can be cancelled (PacketRat-CLI.bat inbox cancel):
# PACKETRAT_LLM_STREAM=1

# --- Outlook ---
# PACKETRAT_MAX_EMAILS=40
# PACKETRAT_BODY_PREVIEW_CHARS=280
# PACKETRAT_PROVIDER=COM

# Privacy: raw AI output may include sensitive mail content; not saved by default.
# Only if approved for debugging: PACKETRAT_SAVE_RAW_AI=1
